# Copy to .env and fill in. Never commit the filled-in file.

# Postgres
POSTGRES_DB=pixabay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=choose-a-password

# Signing key for auth tokens. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Mailtrap sandbox (https://mailtrap.io) for verification and reset emails
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@pixabay-app.local

# Pixabay API key (https://pixabay.com/api/docs/)
REACT_APP_PIXABAY_API_KEY=
